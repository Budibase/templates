{
  "name": "budibase-templates",
  "description": "Collection of Budibase templates",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "new": "node scripts/new-package.js",
    "build:manifest": "node scripts/build-manifest.js",
    "build:tar": "node scripts/build-tar.js",
    "build": "node scripts/build.js",
    "publish": "node scripts/publish.js",
    "publish:ci": "run-s build publish",
    "validate:projects": "node scripts/validate-projects.js",
    "build:projects": "node scripts/build-projects.js",
    "publish:projects": "node scripts/publish-projects.js",
    "publish:projects:ci": "run-s build:projects publish:projects",
    "test": "node --test test/*.test.js",
    "format": "prettier --write \"{,!(node_modules)/**/}*.{js,jsx,svelte}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1034.0",
    "fs-extra": "^9.0.1",
    "semver": "^7.5.4",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "aws-sdk": "^2.757.0",
    "babel-eslint": "^10.0.3",
    "eslint": "^7.9.0",
    "eslint-plugin-prettier": "^3.1.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.1.2"
  }
}
